# =============================================================================
# Lua (루아) — 환경변수 템플릿
# =============================================================================
# 복사: cp .env.example .env.local  (Dev Windows)
# Prd Rocky Linux: CI/CD 또는 서버 배포 스크립트에서 주입
#
# Dev  — local PC (Windows), pnpm dev / pnpm build
# Prd  — Rocky Linux (iwinv), nginx가 apps/web/out/ 정적 서빙
# =============================================================================

# --- 공통 ---
NODE_ENV=development
# production (Prd 빌드 시)

# --- 사이트 URL (SEO·OG·sitemap base) ---
# Dev:  http://localhost:3000
# Prd:  https://YOUR_DOMAIN  ← 도메인 확정 후 packages/env/site.json domain 과 동기화
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Prd 서버 (Rocky Linux / iwinv) — 미확정 ---
# DEPLOY_HOST=              # Public IP — iwinv VM 할당 후 입력
# DEPLOY_USER=              # SSH 사용자 (예: rocky)
# DEPLOY_ROOT=/var/www/lua/current
# DEPLOY_DOMAIN=            # 운영 도메인 — DNS 설정 후 입력

# --- 빌드 (Dev/CI) ---
# CI=true                   # CI 환경에서 pnpm non-interactive 모드
